# ==========================================
# LinguaPulse Environment Configuration
# ==========================================

# GEMINI_API_KEY: Required for neural machine translation across languages.
# Automatically injected in Google AI Studio.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base URL of the application
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT=3000

# SUPABASE CONFIGURATION (For production persistent PostgreSQL + RLS + Realtime)
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# EMAIL DISPATCH PROVIDER (For production Email OTP delivery)
# e.g., Resend (recommended) or SendGrid
RESEND_API_KEY="re_123456789"
EMAIL_FROM="LinguaPulse <auth@linguapulse.app>"

# STRIPE BILLING (For Pro tier subscription and word quota upgrades)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
